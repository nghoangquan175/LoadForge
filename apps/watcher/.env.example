PORT=4100
CORS_ORIGINS=http://localhost:3100

# auto: AWS when ASG_NAME is set and reachable, otherwise mock | aws | mock
DATA_SOURCE=auto
AWS_REGION=ap-southeast-1
# ASG_NAME=loadforge-asg
# ALB_ARN_SUFFIX=app/loadforge-alb/0123456789abcdef
TARGET_CPU=60
AWS_POLL_MS=15000
MOCK_TICK_MS=2000
# Each Defender's /live (on its health port), every second
LIVE_POLL_MS=1000
DEFENDER_LIVE_PORT=4001
