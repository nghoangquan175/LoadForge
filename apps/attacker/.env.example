PORT=4200

# The ONLY URL k6 will hit. Set at deploy time; a control request cannot change it.
ATTACK_TARGET=https://loadforge.quannh.xyz/api/load/cpu?limit=300000

# Ceilings a control request may ask for.
MAX_RATE=1000
MAX_DURATION_SEC=1800
MAX_VUS=800

# Shared bearer token the caller must send on /control/* (empty = no token check).
# CONTROL_TOKEN=change-me

CORS_ORIGINS=http://localhost:3100

# Usually left default; the Docker image puts k6 and the script on the PATH.
# K6_BIN=k6
# K6_SCRIPT=./k6/attack.js
