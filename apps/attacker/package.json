{
  "name": "@loadforge/attacker",
  "version": "0.0.1",
  "description": "Drives k6 load against the LoadForge system, controlled over a small HTTP API",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/main.js",
    "start:dev": "node --watch --experimental-strip-types src/main.ts",
    "lint": "oxlint --type-aware src/",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  }
}
