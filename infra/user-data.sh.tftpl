#!/bin/bash
# Boots a LoadForge ${app} instance. Log: /var/log/loadforge-bootstrap.log
# Rendered by Terraform: only $${...} and %%{...} are Terraform, plain $VAR is bash.
set -euxo pipefail
exec > >(tee -a /var/log/loadforge-bootstrap.log) 2>&1

dnf install -y docker
systemctl enable --now docker

# Deploy script: runs now, and again whenever CI ships a new image
# (SSM Run Command on the dashboard; ASG instances are replaced instead).
cat > /usr/local/bin/loadforge-deploy <<'DEPLOY'
#!/bin/bash
# Pull the image named in SSM and (re)start the container with env from SSM.
# No tracing: the GHCR token and app secrets must not reach the log.
set -euo pipefail
exec > >(tee -a /var/log/loadforge-deploy.log) 2>&1
echo "== $(date -Is) deploying ${app}"

param() {
  aws ssm get-parameter --region ${region} --name "$1" --with-decryption --query Parameter.Value --output text
}

IMAGE=$(param ${image_param})
echo "image: $IMAGE"

param ${ghcr_token_param} | docker login ghcr.io --username ${ghcr_user} --password-stdin
docker pull "$IMAGE"
docker logout ghcr.io

# Env from SSM Parameter Store, root-only: ${env_path}KEY = value -> KEY=value
install -d -m 700 /etc/loadforge
aws ssm get-parameters-by-path --region ${region} --path ${env_path} --with-decryption \
  --query "Parameters[].[Name,Value]" --output text \
  | awk -F'\t' '{ n = split($1, part, "/"); print part[n] "=" $2 }' > /etc/loadforge/app.env
%{ if app == "server" ~}
# Instance id for the X-Served-By header.
IMDS_TOKEN=$(curl -fsS -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
echo "INSTANCE_ID=$(curl -fsS -H "X-aws-ec2-metadata-token: $IMDS_TOKEN" http://169.254.169.254/latest/meta-data/instance-id)" >> /etc/loadforge/app.env
%{ endif ~}
chmod 600 /etc/loadforge/app.env
echo "env: $(cut -d= -f1 /etc/loadforge/app.env | tr '\n' ' ')"

docker rm -f loadforge 2>/dev/null || true
docker run -d --name loadforge --restart unless-stopped \
  -p ${port}:${port} \
%{ if health_port != "" ~}
  -p ${health_port}:${health_port} \
%{ endif ~}
  --env-file /etc/loadforge/app.env \
  "$IMAGE"
docker image prune -f >/dev/null
echo "== deployed $IMAGE"
DEPLOY
chmod 700 /usr/local/bin/loadforge-deploy

/usr/local/bin/loadforge-deploy
