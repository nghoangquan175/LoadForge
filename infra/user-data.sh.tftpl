#!/bin/bash
# Boots a LoadForge ${role} instance: ${join(", ", [for c in containers : c.name])}.
# Log: /var/log/loadforge-bootstrap.log
# Rendered by Terraform: only $${...} and %%{...} are Terraform, plain $VAR is bash.
set -euxo pipefail
exec > >(tee -a /var/log/loadforge-bootstrap.log) 2>&1

%{ if docker_preinstalled ~}
# ECS-optimized AMI: Docker is built in. Its ECS agent is not used, stop it
# before it starts (it is queued after user-data) and on every later boot.
systemctl mask --now --no-block ecs.service
command -v aws >/dev/null || dnf install -y awscli-2
%{ else ~}
dnf install -y docker
%{ endif ~}
systemctl enable --now docker

# Deploy script: runs now, and again whenever CI ships a new image
# (SSM Run Command on the dashboard instance; ASG instances are replaced instead).
cat > /usr/local/bin/loadforge-deploy <<'DEPLOY'
#!/bin/bash
# Pull each image named in SSM and (re)start its container with env from SSM.
# No tracing: the GHCR token and app secrets must not reach the log.
set -euo pipefail
exec > >(tee -a /var/log/loadforge-deploy.log) 2>&1
echo "== $(date -Is) deploying"

param() {
  aws ssm get-parameter --region ${region} --name "$1" --with-decryption --query Parameter.Value --output text
}

instance_id() {
  local token
  token=$(curl -fsS -X PUT http://169.254.169.254/latest/api/token -H "X-aws-ec2-metadata-token-ttl-seconds: 300")
  curl -fsS -H "X-aws-ec2-metadata-token: $token" http://169.254.169.254/latest/meta-data/instance-id
}

# deploy NAME IMAGE_PARAM ENV_PATH WITH_INSTANCE_ID [docker run args...]
deploy() {
  local name=$1 image_param=$2 env_path=$3 with_id=$4
  shift 4
  local image env_file=/etc/loadforge/$name.env
  image=$(param "$image_param")
  echo "$name: $image"
  docker pull "$image"

  # Env from SSM Parameter Store, root-only: <env_path>KEY = value -> KEY=value
  aws ssm get-parameters-by-path --region ${region} --path "$env_path" --with-decryption \
    --query "Parameters[].[Name,Value]" --output text \
    | awk -F'\t' '{ n = split($1, part, "/"); print part[n] "=" $2 }' > "$env_file"
  # Instance id for the X-Served-By header and per-server metrics.
  if [ "$with_id" = true ]; then echo "INSTANCE_ID=$(instance_id)" >> "$env_file"; fi
  chmod 600 "$env_file"
  echo "$name env: $(cut -d= -f1 "$env_file" | tr '\n' ' ')"

  docker rm -f "$name" 2>/dev/null || true
  docker run -d --name "$name" --restart unless-stopped --env-file "$env_file" "$@" "$image"
}

install -d -m 700 /etc/loadforge
param ${ghcr_token_param} | docker login ghcr.io --username ${ghcr_user} --password-stdin
trap 'docker logout ghcr.io >/dev/null 2>&1 || true' EXIT

%{ for c in containers ~}
deploy ${c.name} ${c.image_param} ${c.env_path} ${c.instance_id} ${join(" ", [for p in c.ports : "-p ${p}:${p}"])}
%{ endfor ~}

docker image prune -f >/dev/null
echo "== deployed"
DEPLOY
chmod 700 /usr/local/bin/loadforge-deploy

/usr/local/bin/loadforge-deploy
